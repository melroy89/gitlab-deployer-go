GITLAB_SECRET_TOKEN=
GITLAB_HOSTNAME=gitlab.com

# direct (default) extracts into DESTINATION_PATH; batch uses it as a durable spool.
DEPLOYMENT_MODE=direct
#DEPLOYMENT_ENVIRONMENT=production
DESTINATION_PATH=dest

# Be sure to set your access token for private repositories
#ACCESS_TOKEN=secret_access_token

# Direct mode compatibility options
#USE_JOB_NAME=yes
#PROJECT_ID=123
#REPO_BRANCH=main
#JOB_NAME=deploy
#TEMP_DIR=/tmp

# Optional commands to run after deployment
#POST_DEPLOYMENT_COMMAND="clear"
#POST_DEPLOYMENT_CWD=dest

# Batch mode limits and concurrency
#WORKER_COUNT=2
#MAX_ARTIFACT_BYTES=1073741824
#MAX_EXTRACTED_BYTES=2147483648
#MAX_ARTIFACT_FILES=1000
